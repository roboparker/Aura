<?xml version="1.0"?>
<ruleset name="Aura API">
    <description>PHP_CodeSniffer ruleset for the Aura API — PSR-12 with a few project-specific tweaks.</description>

    <file>src</file>
    <file>tests</file>

    <exclude-pattern>*/var/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <!-- Migrations are autogenerated by Doctrine; we don't hand-edit them. -->
    <exclude-pattern>migrations/*</exclude-pattern>

    <rule ref="PSR12">
        <!-- Doctrine entity columns and Symfony service args routinely overflow
             the soft 120-char limit because of nested attribute payloads;
             reformatting them every time would obscure intent. -->
        <exclude name="Generic.Files.LineLength"/>
    </rule>

    <arg name="colors"/>
    <arg value="p"/>
</ruleset>
