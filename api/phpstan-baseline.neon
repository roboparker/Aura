# Pre-existing PHPStan violations as of the level-5 rollout. Regenerate
# with: docker compose run --rm phpstan analyse --generate-baseline=phpstan-baseline.neon
# after clearing a batch. Anything new fails CI; baselined errors do not.

parameters:
    ignoreErrors:
        # API Platform's FilterInterface::getDescription() return shape
        # narrows `openapi` to `ApiPlatform\OpenApi\Model\Parameter`, but
        # the runtime accepts a plain array. Switching every filter to
        # Parameter objects is a bigger lift than this PR; tracked for a
        # follow-up.
        -
            message: '#Method App\\Filter\\[A-Za-z]+::getDescription\(\) should return array.*but returns array#'
            paths:
                - src/Filter/*.php
