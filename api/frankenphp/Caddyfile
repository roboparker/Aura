{
	skip_install_trust

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}

		worker {
			file ./public/index.php

			{$FRANKENPHP_WORKER_CONFIG}
		}
	}
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME:localhost} {
	log {
		# Redact the authorization query parameter that can be set by Mercure
		format filter {
			request>uri query {
				replace authorization REDACTED
			}
		}
	}

	root /app/public
	encode zstd br gzip

	mercure {
		# Transport to use (default to Bolt). The Mercure Caddy module that
		# ships with mercure-bundle 0.4 replaced the old
		# `transport_url bolt:///path/to/db` scalar with a subdirective block.
		transport bolt {
			path /data/mercure.db
		}
		# Publisher JWT key
		publisher_jwt {env.MERCURE_PUBLISHER_JWT_KEY} {env.MERCURE_PUBLISHER_JWT_ALG}
		# Subscriber JWT key
		subscriber_jwt {env.MERCURE_SUBSCRIBER_JWT_KEY} {env.MERCURE_SUBSCRIBER_JWT_ALG}
		# Allow anonymous subscribers (double-check that it's what you want)
		anonymous
		# Enable the subscription API (double-check that it's what you want)
		subscriptions
		# Extra directives
		{$MERCURE_EXTRA_DIRECTIVES}
	}

	vulcain

	# Add links to the API docs and to the Mercure Hub if not set explicitly (e.g. the PWA)
	header ?Link `</docs.jsonld>; rel="http://www.w3.org/ns/hydra/core#apiDocumentation", </.well-known/mercure>; rel="mercure"`
	# Disable Topics tracking if not enabled explicitly: https://github.com/jkarlin/topics
	header ?Permissions-Policy "browsing-topics=()"

	# Security headers, applied to every response (PWA, API, /media/*, and
	# the Mercure SSE endpoint — headers are sent once when the stream
	# opens, so they don't interfere with event delivery). Browsers only
	# honor HSTS over a trusted HTTPS connection, so the self-signed dev
	# cert on localhost is unaffected. Nothing in the app is iframed, so
	# DENY is safe.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	route {
		# Maintenance mode: scripts/deploy.sh touches this flag file (in the
		# maintenance_flag named volume, so it survives the container swap)
		# while it backs up the DB and swaps images, and removes it once the
		# new stack is healthy. Container healthchecks probe via
		# https://localhost and must keep passing mid-deploy, so localhost is
		# exempt. The flag never exists in dev — this block is inert there.
		@maintenance {
			file {
				root /app/var/maintenance
				try_files maintenance.on
			}
			not host localhost
		}
		handle @maintenance {
			header Retry-After 60
			header Cache-Control "no-store"
			root * /etc/frankenphp
			rewrite * /maintenance.html
			file_server {
				status 503
			}
		}

		# Serve user-uploaded media (avatars, attachments) directly from disk
		handle_path /media/* {
			root * /app/var/media
			file_server
		}

		# Umami analytics, proxied first-party so the tracker is same-origin
		# (no extra DNS/cert, far less ad-block exposure). Only the tracker
		# script and the collect endpoint are exposed — the Umami dashboard
		# itself is NOT reachable through this host; it gets its own site
		# block (see the {$UMAMI_SERVER_NAME} block at the bottom of this
		# file), or the loopback-published port of the umami service.
		# The tracker derives its endpoint from the script src path, so
		# /umami/script.js posts events to /umami/api/send. When the umami
		# container isn't running (profile off) these paths 502; the PWA
		# loads the script async and only when configured, so nothing breaks.
		handle /umami/script.js {
			rewrite * /script.js
			reverse_proxy umami:3000
		}
		handle /umami/api/send {
			rewrite * /api/send
			reverse_proxy umami:3000
		}

		# Matches requests for HTML documents, for static files and for Next.js files,
		# except for known API paths and paths with extensions handled by API Platform
		@pwa expression `(
				header({'Accept': '*text/html*'})
				&& !path(
					'/docs*', '/graphql*', '/bundles*', '/contexts*', '/_profiler*', '/_wdt*',
					'*.json*', '*.html', '*.csv', '*.yml', '*.yaml', '*.xml'
				)
			)
			|| path('/favicon.ico', '/manifest.json', '/robots.txt', '/sitemap*', '/_next*', '/__next*')
			|| query({'_rsc': '*'})`

		# Comment the following line if you don't want Next.js to catch requests for HTML documents.
		# In this case, they will be handled by the PHP app.
		reverse_proxy @pwa http://{$PWA_UPSTREAM}

		@phpRoute {
			not path /.well-known/mercure*
			not file {path}
		}
		rewrite @phpRoute index.php

		@frontController path index.php
		php @frontController

		file_server {
			hide *.php
		}
	}
}

# Public Umami dashboard. The official Umami image can't be served under a
# sub-path (BASE_PATH is a build-time option), so the dashboard gets its own
# hostname instead of living under /umami/ like the tracker endpoints above.
# Point a DNS record at this server and set UMAMI_SERVER_NAME to the hostname
# (e.g. analytics.example.com) — Caddy provisions the certificate
# automatically; access is gated by Umami's own login. When the variable is
# unset the block falls back to a loopback-only port inside the container
# that is never published, so nothing is exposed; the SSH-tunnel route via
# the loopback-published UMAMI_PORT keeps working either way.
{$UMAMI_SERVER_NAME:localhost:8455} {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	reverse_proxy umami:3000
}
