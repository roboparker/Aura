{# @var notifications App\Entity\Notification[] #}
{# @var recipient \App\Entity\User #}
<p>Hi {{ recipient.givenName ?: recipient.email }},</p>

<p>
    Here's your {{ period }} digest from Madori — {{ notifications|length }} notification{{ notifications|length == 1 ? '' : 's' }} since the last batch.
</p>

<ul>
    {% for n in notifications %}
        <li>
            <strong>{{ n.title }}</strong>
            {% if n.body %}<br>{{ n.body }}{% endif %}
        </li>
    {% endfor %}
</ul>

<p>
    <a href="{{ tasksUrl }}">Open Madori</a> to review the details or change your notification frequency.
</p>

<p>&mdash; Madori</p>
