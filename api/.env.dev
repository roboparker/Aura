# define your env variables for the dev env here

###> app rate limits ###
# Effectively unlimited in dev: the E2E suite (and local manual testing)
# registers and signs in many users per run, all from the host's single
# IP, which would trip the prod-sized defaults in .env within one run.
# Tighten in .env.dev.local if you're exercising the throttles by hand.
RATE_LIMIT_LOGIN_ATTEMPTS=100000
RATE_LIMIT_LOGIN_ATTEMPTS_PER_IP=100000
RATE_LIMIT_SIGNUPS_PER_IP=100000
RATE_LIMIT_FORGOT_PASSWORD_PER_IP=100000
RATE_LIMIT_FORGOT_PASSWORD_PER_EMAIL=100000
###< app rate limits ###
