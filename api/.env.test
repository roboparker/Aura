# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
SYMFONY_DEPRECATIONS_HELPER=999999
PANTHER_APP_ENV=panther
PANTHER_ERROR_SCREENSHOT_DIR=./var/error-screenshots

# API Platform distribution
TRUSTED_HOSTS=^example\.com|localhost$

###> app rate limits ###
# Effectively unlimited: the suite registers hundreds of users per run,
# all from 127.0.0.1, and the limiter windows live in the filesystem
# cache pool which persists across runs. RateLimitTest overrides these
# per-test via $_ENV (env placeholders resolve at runtime) and isolates
# its buckets with unique X-Forwarded-For IPs, so the throttle paths
# stay covered without tripping the rest of the suite.
RATE_LIMIT_LOGIN_ATTEMPTS=100000
RATE_LIMIT_LOGIN_ATTEMPTS_PER_IP=100000
RATE_LIMIT_SIGNUPS_PER_IP=100000
RATE_LIMIT_FORGOT_PASSWORD_PER_IP=100000
RATE_LIMIT_FORGOT_PASSWORD_PER_EMAIL=100000
###< app rate limits ###

###> stripe (billing) ###
# The suite swaps in App\Tests\Billing\InMemoryStripeGateway (which reports
# itself configured), so the secret/webhook keys can stay empty. The Price IDs
# must be non-empty, though — BillingController reads them to build the Checkout
# line item and 503s when blank.
STRIPE_PRICE_TEAM_MONTHLY=price_test_monthly
STRIPE_PRICE_TEAM_YEARLY=price_test_yearly
###< stripe (billing) ###
