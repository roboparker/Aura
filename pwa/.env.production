# Loaded by `next build` when NODE_ENV=production — i.e. baked into the prod
# image CI builds. Safe to commit: nothing here is secret.
#
# Umami analytics website ID (see docs/developer/analytics.md). Created once
# in the Umami dashboard (Settings → Websites → Add website), then committed
# here — the ID ships in the page source anyway, it is not a secret. While
# unset, the tracker script is never rendered and analytics is fully off.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=0217ffc5-83a0-4640-8ea3-79e4b4f75840
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BI0zaJu3pluxfEaKoSa2r1lnpwv_mlU1y7GTKPwNKGlsl8LgjlXS35HtB8RNJJQT3MkOijxca2z_mDOwdOlDD5A

# Public site origin (no trailing slash). Used at build to emit absolute
# canonical + OpenGraph URLs on the blog pages and the generated
# /sitemap.xml. Set this to the production domain.
NEXT_PUBLIC_SITE_URL=https://madori.app
